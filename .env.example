# ==============================================================================
# CivicFlow AI-X / Awaaz AI — Production Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Server & Gateway Configuration
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
CORS_ORIGIN=*

# ------------------------------------------------------------------------------
# 2. Database & Data Stores
# ------------------------------------------------------------------------------
# MongoDB (Leave empty to use built-in resilient offline JSON mock store)
MONGODB_URI=mongodb://localhost:27017/awaaz_db

# PostgreSQL / PostGIS (Spatial & TimescaleDB Telemetry Store)
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/awaaz_db

# Redis Cluster / Key-Value Cache & Asynchronous Task Queue
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
JWT_SECRET=awaaz-ai-production-super-secret-key-change-in-production-2026
ADMIN_SECRET_KEY=admin-override-production-secret-2026

# Google OAuth (Optional — falls back to demo one-click authentication if unset)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 4. AI Inference & Computer Vision Services
# ------------------------------------------------------------------------------
# Python YOLO / CLIP / OpenCV Privacy Shield & Verification Service
AI_SERVICE_URL=http://localhost:8000

# Google Gemini / LLM Triage API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. Telegram Civic Grievance Intake Bot
# ------------------------------------------------------------------------------
# Set up via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/complaint

# ------------------------------------------------------------------------------
# 6. Twilio Voice Call & SMS Gateway (Optional — demo mode if unset)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_BASE_URL=https://your-domain.com

# ------------------------------------------------------------------------------
# 7. Email SMTP Notification Engine (Gmail / SendGrid / AWS SES)
# ------------------------------------------------------------------------------
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password

# ------------------------------------------------------------------------------
# 8. B2B Telemetry Gateway & Webhook Security (Zomato / Swiggy / Zepto / Uber)
# ------------------------------------------------------------------------------
B2B_WEBHOOK_SECRET=b2b_hmac_secret_sha256_awaaz_2026
RATE_LIMIT_PUBLIC=100
RATE_LIMIT_DEVELOPER=1000
RATE_LIMIT_ENTERPRISE=50000

# ------------------------------------------------------------------------------
# 9. Frontend Client Environment Variables
# ------------------------------------------------------------------------------
# If deploying Frontend separately (e.g. Vercel) pointing to Backend (e.g. Render):
# VITE_API_URL=https://your-backend-api.onrender.com
# Leave blank when deploying monolithic or using relative proxy:
VITE_API_URL=
